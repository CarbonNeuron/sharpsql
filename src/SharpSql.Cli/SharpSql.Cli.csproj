<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sharpsql</ToolCommandName>
    <PackageId>SharpSql.Tool</PackageId>
    <Description>Command-line compiler for transpiling supported C# programs to self-contained T-SQL batches.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>csharp;sql;transpiler;compiler;roslyn;sqlserver;dotnet-tool</PackageTags>
    <!-- dotnet pack sets _IsPacking before its implicit restore. Keeping the
         platform graph out of ordinary restores avoids downloading every RID's
         runtime pack during builds and tests. -->
    <RuntimeIdentifiers Condition="'$(_IsPacking)' == 'true'">linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.31" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <ProjectReference Include="../SharpSql.MSBuild/SharpSql.MSBuild.csproj" />
    <ProjectReference Include="../SharpSql.SqlServer/SharpSql.SqlServer.csproj" />
    <ProjectReference Include="../SharpSql/SharpSql.csproj" />
    <ProjectReference Include="../SharpSql.Conformance/SharpSql.Conformance.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpSql.Tests" />
  </ItemGroup>
</Project>
