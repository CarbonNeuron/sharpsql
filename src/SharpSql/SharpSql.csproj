<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>SharpSql</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>An experimental Roslyn-based C# to T-SQL transpiler.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <ProjectReference Include="../SharpSql.Ir/SharpSql.Ir.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpSql.Tests" />
    <InternalsVisibleTo Include="SharpSql.Cli" />
    <InternalsVisibleTo Include="SharpSql.IntegrationTests" />
  </ItemGroup>
</Project>
