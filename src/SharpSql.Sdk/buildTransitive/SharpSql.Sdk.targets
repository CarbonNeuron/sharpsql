<Project>
  <PropertyGroup>
    <SharpSqlBuildHostPath Condition="'$(SharpSqlBuildHostPath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/net10.0/any/SharpSql.Build.dll'))</SharpSqlBuildHostPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(SharpSqlEnabled)' == 'true' and '$(SharpSqlEnableAnalyzer)' == 'true'">
    <Analyzer Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/analyzers/SharpSql.Analyzers.dll'))" />
    <Analyzer Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/analyzers/SharpSql.dll'))" />
    <Analyzer Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/analyzers/SharpSql.Ir.dll'))" />
  </ItemGroup>

  <Target Name="SharpSqlTranspile"
          Condition="'$(SharpSqlEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <SharpSqlResolvedOutputPath Condition="'$(SharpSqlOutputPath)' != ''">$(SharpSqlOutputPath)</SharpSqlResolvedOutputPath>
      <SharpSqlResolvedOutputPath Condition="'$(SharpSqlResolvedOutputPath)' == '' and '$(SharpSqlOutputLocation)' == 'BuildOutput'">$(OutputPath)$(AssemblyName).sql</SharpSqlResolvedOutputPath>
      <SharpSqlResolvedOutputPath Condition="'$(SharpSqlResolvedOutputPath)' == ''">$(IntermediateOutputPath)sharpsql/$(AssemblyName).sql</SharpSqlResolvedOutputPath>
      <_SharpSqlRuntimeStorageLower>$([System.String]::Copy('$(SharpSqlRuntimeStorage)').ToLowerInvariant())</_SharpSqlRuntimeStorageLower>
    </PropertyGroup>
    <Error Condition="!Exists('$(SharpSqlBuildHostPath)')"
           Text="SharpSql build host was not found at '$(SharpSqlBuildHostPath)'." />
    <Error Condition="'$(_SharpSqlRuntimeStorageLower)' != 'ephemeral' and '$(_SharpSqlRuntimeStorageLower)' != 'durable' and '$(_SharpSqlRuntimeStorageLower)' != 'servicebroker'"
           Text="SharpSqlRuntimeStorage must be Ephemeral, Durable, or ServiceBroker." />
    <Exec Command="dotnet &quot;$(SharpSqlBuildHostPath)&quot; --project &quot;$(MSBuildProjectFullPath)&quot; --output &quot;$(SharpSqlResolvedOutputPath)&quot; --configuration &quot;$(Configuration)&quot; --framework &quot;$(TargetFramework)&quot; --entry &quot;$(SharpSqlEntryPoint)&quot; --runtime-storage &quot;$(SharpSqlRuntimeStorage)&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
    <ItemGroup>
      <FileWrites Include="$(SharpSqlResolvedOutputPath)" />
    </ItemGroup>
  </Target>

  <Target Name="SharpSqlGenerateOnBuild"
          AfterTargets="CoreCompile"
          DependsOnTargets="SharpSqlTranspile"
          Condition="'$(SharpSqlEnabled)' == 'true' and '$(SharpSqlGenerateOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'" />

  <Target Name="SharpSqlRun"
          DependsOnTargets="SharpSqlTranspile"
          Condition="'$(SharpSqlEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Message Text="SharpSql: starting SQL Server execution for $(MSBuildProjectName)..."
             Importance="High" />
    <Exec Command="dotnet &quot;$(SharpSqlBuildHostPath)&quot; --operation run --project &quot;$(MSBuildProjectFullPath)&quot; --sql &quot;$(SharpSqlResolvedOutputPath)&quot; --runtime-storage &quot;$(SharpSqlRuntimeStorage)&quot; --connection-name &quot;$(SharpSqlConnectionName)&quot; --connection-string-environment &quot;$(SharpSqlConnectionStringEnvironment)&quot; --force-container &quot;$(SharpSqlForceContainer)&quot; --keep-container &quot;$(SharpSqlKeepContainer)&quot; --image &quot;$(SharpSqlContainerImage)&quot; --database &quot;$(SharpSqlContainerDatabase)&quot; --timeout &quot;$(SharpSqlCommandTimeoutSeconds)&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
    <Message Text="SharpSql: SQL Server execution target completed."
             Importance="High" />
  </Target>
</Project>
