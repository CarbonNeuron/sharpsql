<Project>
  <PropertyGroup>
    <SharpSqlEnabled Condition="'$(SharpSqlEnabled)' == ''">true</SharpSqlEnabled>
    <SharpSqlEnableAnalyzer Condition="'$(SharpSqlEnableAnalyzer)' == ''">true</SharpSqlEnableAnalyzer>
    <SharpSqlGenerateOnBuild Condition="'$(SharpSqlGenerateOnBuild)' == ''">true</SharpSqlGenerateOnBuild>
    <SharpSqlExecution Condition="'$(SharpSqlExecution)' == ''">Auto</SharpSqlExecution>
    <SharpSqlManagedFallback Condition="'$(SharpSqlManagedFallback)' == ''">Auto</SharpSqlManagedFallback>
    <SharpSqlDurability Condition="'$(SharpSqlDurability)' == ''">Ephemeral</SharpSqlDurability>
    <SharpSqlMemoryOptimized Condition="'$(SharpSqlMemoryOptimized)' == ''">false</SharpSqlMemoryOptimized>
    <SharpSqlOutputLocation Condition="'$(SharpSqlOutputLocation)' == ''">Intermediate</SharpSqlOutputLocation>
    <SharpSqlKeepContainer Condition="'$(SharpSqlKeepContainer)' == ''">false</SharpSqlKeepContainer>
    <SharpSqlForceContainer Condition="'$(SharpSqlForceContainer)' == ''">false</SharpSqlForceContainer>
    <SharpSqlContainerImage Condition="'$(SharpSqlContainerImage)' == ''">mcr.microsoft.com/mssql/server:2022-latest</SharpSqlContainerImage>
    <SharpSqlContainerDatabase Condition="'$(SharpSqlContainerDatabase)' == ''">SharpSql</SharpSqlContainerDatabase>
    <SharpSqlCommandTimeoutSeconds Condition="'$(SharpSqlCommandTimeoutSeconds)' == ''">60</SharpSqlCommandTimeoutSeconds>
    <SkipCompilerExecution Condition="'$(SharpSqlTranspileOnly)' == 'true'">true</SkipCompilerExecution>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="SharpSqlEnableAnalyzer" />
    <CompilerVisibleProperty Include="SharpSqlEntryPoint" />
    <CompilerVisibleProperty Include="SharpSqlExecution" />
    <CompilerVisibleProperty Include="SharpSqlManagedFallback" />
    <CompilerVisibleProperty Include="SharpSqlDurability" />
    <CompilerVisibleProperty Include="SharpSqlMemoryOptimized" />
    <CompilerVisibleProperty Include="SharpSqlRuntimeStorage" />
  </ItemGroup>
</Project>
